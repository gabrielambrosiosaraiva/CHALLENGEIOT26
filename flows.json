    {
        "id": "3304c5cf7937954d",
        "type": "function",
        "z": "8cef024bab2e891f",
        "name": "Processar Banco SQL Local",
        "func": "\nvar linha = msg.payload.toString().trim().toUpperCase();\n\nmsg.query_sql = \"SELECT * FROM tb_veterinarios;\";\n\n\nif (linha.includes(\"D3 67 AA 13\") || linha.includes(\"LIBERADO\")) {\n    msg.payload = {\n        status: \"RECEITA ASSINADA DIGITALMENTE\",\n        cor: \"#2ecc71\",\n        bg: \"#e8f8f5\",\n        vet: \"Dr. Gabriel Ambrosio\",\n        crmv: \"CRMV-SP 45678\",\n        paciente: \"Thor (Canino - Golden Retriever)\",\n        med: \"Amoxicilina 250mg - 1 comprimido de 12h em 12h por 7 dias.\",\n        data: new Date().toLocaleString('pt-BR')\n    };\n    return msg;\n} \n\n\nelse if (linha.includes(\"53 4A D2 26\") || linha.includes(\"NEGADO\")) {\n    msg.payload = {\n        status: \"ACESSO NEGADO - CRMV INATIVO\",\n        cor: \"#e74c3c\",\n        bg: \"#fceae9\",\n        vet: \"Dra. Barbara Mariano\",\n        crmv: \"CRMV-SP 12389 (SUSPENSO)\",\n        paciente: \"SISTEMA BLOQUEADO\",\n        med: \"Assinatura Recusada: Restricao profissional ativa no Conselho.\",\n        data: new Date().toLocaleString('pt-BR')\n    };\n    return msg;\n} \n\n\nelse {\n    return null;\n}",
